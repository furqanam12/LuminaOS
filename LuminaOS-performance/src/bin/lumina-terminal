#!/usr/bin/env bash
# =====================================================================
# LuminaOS Universal Terminal Launcher
# Supports standard Lumina terminal and Kali Linux Security Terminal mode.
# Implements robust fallback across all common terminal emulators.
# =====================================================================

MODE="standard"
TITLE="Terminal"
KALI_RC="/etc/lumina/kali-profile.sh"
USER_KALI_RC="$HOME/.lumina-kali-profile"
FORWARD=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --kali)
            MODE="kali"
            TITLE="Kali Linux Terminal (Security Suite)"
            ;;
        --title=*)
            TITLE="${1#*=}"
            ;;
        -e)
            # Preserve third-party `terminal -e command args...` semantics.
            shift
            while [ "$#" -gt 0 ]; do
                FORWARD+=("$1")
                shift
            done
            break
            ;;
        *)
            FORWARD+=("$1")
            ;;
    esac
    shift
done

RUN=(bash)
if [ "${#FORWARD[@]}" -gt 0 ]; then
    RUN=("${FORWARD[@]}")
elif [ "$MODE" = "kali" ]; then
    export KALI_TERMINAL=1
    export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/share/kali-menu:$PATH"
    if [ -f "$KALI_RC" ]; then
        RUN=(bash --rcfile "$KALI_RC" -i)
    elif [ -f "$USER_KALI_RC" ]; then
        RUN=(bash --rcfile "$USER_KALI_RC" -i)
    else
        echo "Warning: Kali profile not found at $KALI_RC or $USER_KALI_RC."
        echo "Falling back to a regular shell."
    fi
fi

# Never resolve x-terminal-emulator here: this launcher may be its target,
# which would recurse forever. Call only concrete emulators instead.
TERMINALS="xfce4-terminal gnome-terminal mate-terminal lxterminal konsole alacritty kitty xterm"
# xfce/mate/lxterminal take a single command string; %q preserves arguments.
printf -v COMMAND_STRING '%q ' "${RUN[@]}"
for term in $TERMINALS; do
    if command -v "$term" >/dev/null 2>&1; then
        case "$term" in
            xfce4-terminal|mate-terminal|lxterminal)
                exec "$term" --title="$TITLE" --command="$COMMAND_STRING" ;;
            gnome-terminal)
                exec "$term" --title="$TITLE" -- "${RUN[@]}" ;;
            konsole)
                exec "$term" -p "tabtitle=$TITLE" -e "${RUN[@]}" ;;
            alacritty)
                exec "$term" -T "$TITLE" -e "${RUN[@]}" ;;
            kitty)
                exec "$term" --title="$TITLE" "${RUN[@]}" ;;
            xterm)
                exec "$term" -T "$TITLE" -e "${RUN[@]}" ;;
        esac
    fi
done

echo "No terminal emulator available."
exit 1

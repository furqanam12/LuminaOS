#!/usr/bin/env bash
# =====================================================================
# LuminaOS Universal Terminal Launcher
# Supports standard Lumina terminal and Kali Linux Security Terminal mode.
# Implements robust fallback across all common terminal emulators.
# =====================================================================

MODE="standard"
TITLE="Terminal"
KALI_RC="/etc/lumina/kali-profile.sh"
USER_KALI_RC="$HOME/.lumina-kali-profile"

for arg in "$@"; do
    case "$arg" in
        --kali)
            MODE="kali"
            TITLE="Kali Linux Terminal (Security Suite)"
            ;;
        --title=*)
            TITLE="${arg#*=}"
            ;;
        *)
            ;;
    esac
done

# Determine shell command. In Kali mode we source the system-wide profile.
BASH_CMD="bash"
if [ "$MODE" = "kali" ]; then
    export KALI_TERMINAL=1
    export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/share/kali-menu:$PATH"
    if [ -f "$KALI_RC" ]; then
        BASH_CMD="bash --rcfile '$KALI_RC' -i"
    elif [ -f "$USER_KALI_RC" ]; then
        BASH_CMD="bash --rcfile '$USER_KALI_RC' -i"
    else
        echo "Warning: Kali profile not found at $KALI_RC or $USER_KALI_RC."
        echo "Falling back to a regular shell."
    fi
fi

TERMINALS="xfce4-terminal x-terminal-emulator gnome-terminal mate-terminal lxterminal konsole alacritty kitty xterm"
for term in $TERMINALS; do
    if command -v "$term" >/dev/null 2>&1; then
        case "$term" in
            xfce4-terminal)
                if [ "$MODE" = "kali" ]; then
                    exec xfce4-terminal --title="$TITLE" --execute $BASH_CMD
                else
                    exec xfce4-terminal --title="$TITLE"
                fi
                ;;
            gnome-terminal)
                if [ "$MODE" = "kali" ]; then
                    exec gnome-terminal --title="$TITLE" -- $BASH_CMD
                else
                    exec gnome-terminal --title="$TITLE"
                fi
                ;;
            x-terminal-emulator)
                # Often a wrapper script -> can accept the same flags as xfce4-terminal or xterm
                exec "$term" -T "$TITLE" -e $BASH_CMD ;;
            mate-terminal|lxterminal|konsole|alacritty|kitty|xterm)
                if [ "$MODE" = "kali" ]; then
                    exec "$term" -T "$TITLE" -e $BASH_CMD
                else
                    exec "$term" -T "$TITLE"
                fi
                ;;
        esac
        exit 0
    fi
done

echo "No terminal emulator available."
exit 1

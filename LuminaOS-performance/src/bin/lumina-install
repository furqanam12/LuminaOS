#!/bin/sh
# Launch the LuminaOS installer with the least surprising authentication path.
if [ -e /run/live/medium ] && command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
  exec sudo -n -E calamares "$@"
fi
if command -v pkexec >/dev/null 2>&1; then
  exec pkexec calamares "$@"
fi
if command -v zenity >/dev/null 2>&1; then
  zenity --error --title="Install LuminaOS" --text="Calamares could not be started because no authentication helper is available." >/dev/null 2>&1
fi
echo "Install LuminaOS: pkexec or passwordless sudo is required." >&2
exit 1

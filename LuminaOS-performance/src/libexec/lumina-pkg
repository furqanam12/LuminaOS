#!/bin/sh
# Privileged package helper for Lumina Store / Updates / Universal Compatibility.
# Runs as root via sudo or pkexec.
set -e
export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Progress-Fancy=0 -o APT::Status-Fd=1 -o Dpkg::Use-Pty=0"
valid() { for p in "$@"; do case "$p" in *[!a-zA-Z0-9.+_:-]*) echo "invalid package: $p"; exit 2;; esac; done; }
online() { getent hosts deb.debian.org >/dev/null 2>&1 || getent hosts flathub.org >/dev/null 2>&1 || getent hosts http.kali.org >/dev/null 2>&1; }

cmd="$1"; shift || true
case "$cmd" in
  install)
    valid "$@"
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1 || true
    $APT install --no-install-recommends "$@" ;;
    
  remove)
    valid "$@"; $APT remove "$@" ;;
    
  install-file)
    f="$1"; [ -f "$f" ] || { echo "file not found: $f"; exit 2; }
    case "$f" in
      *.deb)
        apt-get update -o APT::Status-Fd=1 || true
        $APT install "$f" ;;
      *.flatpakref)
        command -v flatpak >/dev/null || { apt-get update; $APT install flatpak; }
        flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
        flatpak install -y --noninteractive --from "$f" ;;
      *.flatpak)
        command -v flatpak >/dev/null || { apt-get update; $APT install flatpak; }
        flatpak install -y --noninteractive --bundle "$f" ;;
      *.AppImage|*.appimage)
        chmod +x "$f"
        # Ensure fuse is available
        $APT install fuse3 libfuse2t64 2>/dev/null || $APT install fuse3 libfuse2 2>/dev/null || true
        dest="/usr/local/bin/$(basename "$f" | tr ' ' '_')"
        cp "$f" "$dest"
        chmod +x "$dest"
        echo "Installed AppImage to $dest" ;;
      *.rpm)
        command -v alien >/dev/null || { apt-get update; $APT install alien; }
        alien -i "$f" ;;
      *.snap)
        command -v snap >/dev/null || { apt-get update; $APT install snapd; systemctl enable --now snapd.socket || true; }
        snap install --dangerous "$f" ;;
      *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2)
        dest="/opt/$(basename "$f" | sed -E 's/\.(tar\.(gz|xz|bz2)|tgz)$//')"
        mkdir -p "$dest"
        tar -xf "$f" -C "$dest"
        echo "Extracted package to $dest" ;;
      *.dmg|*.pkg)
        # macOS container/archive inspection
        command -v 7z >/dev/null || { apt-get update; $APT install p7zip-full; }
        outdir="/tmp/mac-extract-$(date +%s)"
        mkdir -p "$outdir"
        7z x "$f" -o"$outdir" -y || true
        echo "macOS archive extracted to $outdir" ;;
      *)
        echo "unsupported file format: $f"; exit 2 ;;
    esac ;;
    
  flatpak-install)
    valid "$@"
    online || { echo "No internet connection"; exit 3; }
    command -v flatpak >/dev/null || { apt-get update; $APT install flatpak; }
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
    flatpak install -y --noninteractive flathub "$@" ;;
    
  flatpak-remove)
    valid "$@"; flatpak uninstall -y --noninteractive "$@" ;;
    
  flatpak-setup)
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1 || true
    $APT install flatpak
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
    echo "Flatpak and Flathub successfully configured." ;;
    
  wine-setup)
    online || { echo "No internet connection"; exit 3; }
    dpkg --add-architecture i386 2>/dev/null || true
    apt-get update -o APT::Status-Fd=1 || true
    $APT install wine wine32:i386 wine64 winetricks cabextract 2>/dev/null || $APT install wine winetricks cabextract 2>/dev/null || true
    echo "Wine compatibility layer successfully configured." ;;

  appimage-setup)
    apt-get update -o APT::Status-Fd=1 || true
    $APT install fuse3 libfuse2t64 2>/dev/null || $APT install fuse3 libfuse2 2>/dev/null || true
    mkdir -p /etc/skel/Applications
    echo "AppImage runtime and FUSE successfully configured." ;;

  snap-setup)
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1 || true
    $APT install snapd
    systemctl enable --now snapd.socket 2>/dev/null || true
    ln -s /var/lib/snapd/snap /snap 2>/dev/null || true
    echo "Snap framework successfully configured." ;;

  kali-setup)
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1 || true
    $APT install gnupg curl ca-certificates
    # Verify the Kali archive key before enabling the optional repository.
    mkdir -p /etc/apt/keyrings /etc/apt/sources.list.d /etc/apt/preferences.d
    key_tmp=$(mktemp)
    if ! curl -fsSL -o "$key_tmp" https://archive.kali.org/archive-key.asc; then
      rm -f "$key_tmp"; echo "Could not download the Kali archive key"; exit 3
    fi
    [ -s "$key_tmp" ] || { rm -f "$key_tmp"; echo "Downloaded Kali key is empty"; exit 3; }
    gpg --dearmor --yes -o /etc/apt/keyrings/kali-archive-keyring.gpg.new "$key_tmp"
    rm -f "$key_tmp"
    install -m 0644 /etc/apt/keyrings/kali-archive-keyring.gpg.new /etc/apt/keyrings/kali-archive-keyring.gpg
    rm -f /etc/apt/keyrings/kali-archive-keyring.gpg.new
    # Use HTTPS, keyring-scoped trust and low priority. Never overwrite a
    # customized source list or silently continue on signature errors.
    cat > /etc/apt/sources.list.d/kali.list << 'EOF'
deb [signed-by=/etc/apt/keyrings/kali-archive-keyring.gpg] https://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
EOF
    cat > /etc/apt/preferences.d/kali.pref << 'EOF'
Package: *
Pin: release o=Kali
Pin-Priority: 100
EOF
    if ! apt-get update -o APT::Status-Fd=1; then
      rm -f /etc/apt/sources.list.d/kali.list
      echo "Kali repository verification failed; the source was disabled again." >&2
      exit 4
    fi
    echo "Kali repository enabled with signature checking and low package priority. Debian remains the default." ;;

  kali-install)
    [ "$#" -gt 0 ] || { echo "no packages specified"; exit 2; }
    valid "$@"
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1
    if [ -f /etc/apt/sources.list.d/kali.list ]; then
      $APT install -t kali-rolling "$@"
    else
      echo "Kali repository is not configured; using Debian packages only." >&2
      $APT install "$@"
    fi ;;

  kali-msf)
    [ -f /etc/apt/sources.list.d/kali.list ] || { echo "Configure Kali Repositories first, then install Metasploit."; exit 2; }
    "$0" kali-install metasploit-framework ;;

  kali-tools-install)
    if [ -x /usr/local/bin/kali-tools ]; then
      echo "kali-tools is already installed at /usr/local/bin/kali-tools"
    elif [ -x /usr/libexec/lumina/kali-tools ]; then
      install -D -m 755 /usr/libexec/lumina/kali-tools /usr/local/bin/kali-tools
      echo "kali-tools installed to /usr/local/bin/kali-tools"
    else
      echo "kali-tools was not found in this image"; exit 2
    fi ;;

  terminal-fix)
    apt-get update -o APT::Status-Fd=1 || true
    $APT install xfce4-terminal xterm 2>/dev/null || true
    chmod +x /usr/bin/lumina-terminal 2>/dev/null || true
    for term in /usr/bin/xfce4-terminal.wrapper /usr/bin/xfce4-terminal; do
      if [ -x "$term" ]; then
        update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator "$term" 80 2>/dev/null || true
        update-alternatives --set x-terminal-emulator "$term" 2>/dev/null || true
        break
      fi
    done
    echo "Terminal alternatives, wrappers, and permissions restored." ;;

  check)
    apt-get update -o APT::Status-Fd=1 >/dev/null 2>&1 || true
    apt-get -s upgrade ;;
    
  upgrade)
    online || { echo "No internet connection"; exit 3; }
    apt-get update -o APT::Status-Fd=1
    $APT upgrade ;;
    
  android-setup)
    online || { echo "No internet connection"; exit 3; }
    os_id="$(. /etc/os-release && echo "${ID:-}")"
    os_codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
    if [ "$os_id" = "debian" ] && [ "$os_codename" = "trixie" ]; then
      if ! grep -Rqs '^deb .*trixie-backports' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
        echo "deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware" > /etc/apt/sources.list.d/trixie-backports.list
      fi
      apt-get update -o APT::Status-Fd=1
      $APT install -t trixie-backports waydroid weston
    else
      # Do not execute an unverified third-party script as root. The supported
      # LuminaOS 1.1 target is Debian 13; other systems need manual verification.
      echo "Automatic Android setup is supported only on Debian 13 (trixie). Detected: $os_id $os_codename." >&2
      echo "Use a verified Waydroid and Weston package setup for this distribution." >&2
      exit 2
    fi
    echo "Waydroid and Weston installed. Android runs in a nested Wayland window and needs binder support and an initialized image." ;;
    
  *)
    echo "usage: lumina-pkg install|remove|install-file|flatpak-install|flatpak-remove|flatpak-setup|wine-setup|appimage-setup|snap-setup|kali-setup|kali-install|terminal-fix|check|upgrade|android-setup"; exit 1 ;;
esac

#!/bin/sh
# LuminaOS: emit an installed GRUB menu entry for safe-graphics recovery.
# grub-mkconfig exports the discovered filesystem UUIDs to scripts in /etc/grub.d.
ROOT_UUID="${GRUB_DEVICE_UUID:-}"
[ -n "$ROOT_UUID" ] || exit 0
BOOT_UUID="${GRUB_DEVICE_BOOT_UUID:-$ROOT_UUID}"

KERNEL=""
INITRD=""
for f in /boot/vmlinuz-*; do
  [ -f "$f" ] || continue
  case "$f" in *.old) continue ;; esac
  KERNEL="$f"
  INITRD="${f/vmlinuz-/initrd.img-}"
  break
done
[ -n "$KERNEL" ] && [ -f "$INITRD" ] || exit 0

KPATH="/${KERNEL#/boot/}"
IPATH="/${INITRD#/boot/}"

cat <<EOF
menuentry 'LuminaOS (safe graphics)' --class lumina --class gnu-linux --class os {
    recordfail
    load_video
    set gfxpayload=keep
    insmod gzio
    search --no-floppy --fs-uuid --set=root ${BOOT_UUID}
    echo 'Loading LuminaOS with safe graphics...'
    linux ${KPATH} root=UUID=${ROOT_UUID} ro nomodeset quiet loglevel=3
    echo 'Loading initial ramdisk...'
    initrd ${IPATH}
}
EOF
